---
// Homepage tools-suite portal grid.
// Card 1 links to the live schema generator; cards 2–4 are reserved (Coming Soon).
interface ToolCard {
  name: string;
  desc: string;
  /** Raw inner SVG markup (24x24, stroke) rendered inside the icon tile. */
  icon: string;
  status: 'live' | 'soon';
  href?: string;
}

const TOOL_CARDS: ToolCard[] = [
  {
    status: 'live',
    href: '/tools/schema-generator/',
    name: 'JSON-LD Schema Generator & GEO Checklist',
    desc: 'Generate JSON-LD for Articles, FAQ, Products & Organization with a live GEO Readiness score.',
    icon: '<path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5c0 1.1.9 2 2 2h1"/><path d="M16 21h1a2 2 0 0 0 2-2v-5c0-1.1.9-2 2-2a2 2 0 0 1-2-2V5a2 2 0 0 0-2-2h-1"/>',
  },
  {
    status: 'live',
    href: '/tools/ai-robots-txt-checker/',
    name: 'AI Robots.txt & Crawler Checker',
    desc: 'Verify if GPTBot, PerplexityBot, or ClaudeBot are properly configured in your robots.txt.',
    icon: '<path d="M12 8V4H8"/><rect x="4" y="8" width="16" height="12" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/>',
  },
  {
    status: 'soon',
    name: 'llm.txt File Builder',
    desc: 'Generate optimized llm.txt files to feed structured site context directly to LLMs.',
    icon: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z"/><path d="M14 2v6h6"/><path d="M9 15h6"/><path d="M12 12v6"/>',
  },
  {
    status: 'soon',
    name: 'GEO Citation Analyzer',
    desc: 'Analyze how easily AI search engine pipelines can extract and attribute your page content.',
    icon: '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>',
  },
];
---

<section id="tools" class="mx-auto max-w-7xl scroll-mt-20 px-4 py-16 sm:px-6 lg:px-8">
  <div class="mx-auto mb-12 max-w-2xl text-center">
    <p class="text-xs font-semibold uppercase tracking-widest text-mint-400">Tools directory</p>
    <h2 class="mt-2 text-3xl font-bold tracking-tight text-sand-100 sm:text-4xl">Tools Directory</h2>
    <p class="mt-3 text-sm leading-relaxed text-sand-400">
      Free, no login, no tracking. Only public robots.txt files pass through our edge proxy —
      everything else runs 100% in your browser.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {TOOL_CARDS.map((t) => {
      const body = (
        <>
          <span class="portal-icon mb-4 grid h-11 w-11 place-items-center rounded-xl bg-ink-800 text-sand-300 ring-1 ring-ink-600 transition-colors group-hover:bg-mint-500/10 group-hover:text-mint-400 group-hover:ring-mint-500/30">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" set:html={t.icon} />
          </span>
          <span class="block text-sm font-bold text-sand-100">{t.name}</span>
          <span class="mt-1 block text-xs leading-relaxed text-sand-500">{t.desc}</span>
          <span class="mt-4 flex items-center justify-between">
            {t.status === 'live' ? (
              <>
                <span class="inline-flex items-center gap-1.5 text-xs font-bold text-mint-300">
                  <span class="relative flex h-2 w-2">
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-mint-400 opacity-60"></span>
                    <span class="relative inline-flex h-2 w-2 rounded-full bg-mint-400"></span>
                  </span>
                  Active
                </span>
                <span class="text-xs font-semibold text-mint-400/80 transition-colors group-hover:text-mint-300">
                  Open Tool →
                </span>
              </>
            ) : (
              <span class="inline-flex items-center rounded-full border border-ink-600 px-2.5 py-1 text-[11px] font-medium text-sand-500">
                Coming Soon
              </span>
            )}
          </span>
        </>
      );

      return t.status === 'live' ? (
        <a
          href={t.href}
          class="portal-card portal-live group relative flex flex-col rounded-2xl border border-ink-700 bg-ink-850 p-5 text-left transition-all hover:-translate-y-0.5 hover:border-mint-500/40 hover:shadow-lg hover:shadow-mint-500/5"
        >
          {body}
        </a>
      ) : (
        <div
          aria-disabled="true"
          class="portal-card portal-soon group relative flex flex-col rounded-2xl border border-ink-700/60 bg-ink-850/70 p-5 text-left"
        >
          {body}
        </div>
      );
    })}
  </div>
</section>
