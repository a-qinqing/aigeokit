---
// Shared site header. Nav is URL-based (trailing-slash convention):
// Tools → /tools/ directory, Guide → GEO guide section on the homepage.
const links = [
  { href: '/tools/', label: 'Tools' },
  { href: '/#guide', label: 'Guide' },
];
---

<header class="sticky top-0 z-40 border-b border-ink-700/60 bg-ink-900/85 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8" aria-label="Main">
    <a href="/" class="flex items-center gap-2.5" aria-label="AIGEOKit — home">
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-mint-500/15 ring-1 ring-mint-500/30">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 text-mint-400">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z" />
          <circle cx="12" cy="10" r="3" />
        </svg>
      </span>
      <span class="text-[15px] font-bold tracking-tight text-sand-100">
        AI<span class="text-mint-400">GEO</span>Kit
      </span>
    </a>

    <div class="hidden items-center gap-7 text-sm text-sand-400 md:flex">
      {links.map((l) => (
        <a href={l.href} class="transition-colors hover:text-sand-100">{l.label}</a>
      ))}
    </div>

    <span class="hidden items-center gap-1.5 rounded-full border border-mint-500/25 bg-mint-500/10 px-3 py-1 text-[11px] font-medium text-mint-300 sm:inline-flex">
      ⚡ 100% Client-Side · Free Forever
    </span>
  </nav>
</header>
