---
// Shared semantic site footer — used on the homepage and all tool pages.
---
<footer class="border-t border-zinc-800/60 bg-ink-900 py-12 text-sand-400">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div class="max-w-xl">
        <span class="text-lg font-bold text-sand-100">AIGEOKit</span>
        <p class="mt-2 text-sm text-sand-400">
          Free, privacy-first Generative Engine Optimization (GEO) toolkit for webmasters &amp;
          SEOs. Optimize your structured data to boost citations in SearchGPT, Perplexity, and
          AI Overviews.
        </p>
      </div>
      <div class="space-y-1 text-xs text-sand-500 md:text-right">
        <p class="font-medium text-sand-300">⚡ 100% Client-Side Execution · No Login Required</p>
        <p>Built with Astro, Tailwind CSS &amp; Cloudflare Pages.</p>
        <p class="text-sand-500/70">Zero backend · Zero tracking · Your data never leaves your browser.</p>
      </div>
    </div>
  </div>
</footer>
