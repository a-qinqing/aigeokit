---
import { TOOL_ORDER, TOOLS } from '../lib/tools';

// Schema-type picker for /tools/schema-generator/. The buttons are driven by
// lib/app.ts (state.tool → renderForm/renderOutput/renderChecklist); the
// active card gets .card-active toggled and the page scrolls to #builder.
---

<section id="types" class="mx-auto max-w-7xl scroll-mt-20 px-4 pb-2 pt-10 sm:px-6 lg:px-8">
  <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-mint-400">All generators</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight sm:text-3xl">Pick a schema type</h2>
    </div>
    <p class="max-w-md text-sm leading-relaxed text-sand-500">
      Every generator runs entirely in your browser — switching here updates the form, the
      JSON-LD output and the GEO checklist live.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {TOOL_ORDER.map((id) => {
      const t = TOOLS[id];
      return (
        <button
          type="button"
          data-tool={id}
          class="tool-card group relative flex flex-col rounded-2xl border border-ink-700 bg-ink-850 p-5 text-left transition-all hover:-translate-y-0.5 hover:border-mint-500/40 hover:shadow-lg hover:shadow-mint-500/5"
          aria-pressed="false"
        >
          <span class="tool-card-icon mb-4 grid h-11 w-11 place-items-center rounded-xl bg-ink-800 text-sand-300 ring-1 ring-ink-600 transition-colors group-hover:bg-mint-500/10 group-hover:text-mint-400 group-hover:ring-mint-500/30">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
              <path d={t.icon} />
            </svg>
          </span>
          <span class="text-sm font-bold text-sand-100">{t.name}</span>
          <span class="mt-1 text-xs leading-relaxed text-sand-500">{t.tagline}</span>
          <span class="mt-4 text-xs font-semibold text-mint-400/70 transition-colors group-hover:text-mint-400">
            Open generator →
          </span>
        </button>
      );
    })}
  </div>
</section>
