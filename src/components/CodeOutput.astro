---
const platforms = [
  { id: 'raw', label: 'Raw JSON-LD' },
  { id: 'wordpress', label: 'WordPress (Header Code)' },
  { id: 'shopify', label: 'Shopify (Liquid Theme)' },
];
---

<div class="rounded-2xl border border-ink-700 bg-ink-850">
  <!-- tabs -->
  <div class="flex items-center gap-1 border-b border-ink-700 px-3 pt-3" role="tablist" aria-label="Output platform">
    {platforms.map((p) => (
      <button
        type="button"
        role="tab"
        data-platform={p.id}
        class="platform-tab rounded-t-lg border-b-2 border-transparent px-3.5 py-2.5 text-xs font-semibold text-sand-500 transition-colors hover:text-sand-200"
      >
        {p.label}
      </button>
    ))}
  </div>

  <!-- code -->
  <div class="relative">
    <div class="max-h-[560px] overflow-auto p-4">
      <pre id="output-code" class="whitespace-pre font-mono text-[12.5px] leading-relaxed text-sand-300"></pre>
    </div>
  </div>

  <!-- footer -->
  <div class="flex flex-wrap items-center justify-between gap-3 border-t border-ink-700 px-4 py-3">
    <span id="output-meta" class="text-[11px] uppercase tracking-wide text-sand-500"></span>
    <div class="flex items-center gap-2">
      <button
        type="button"
        id="download-btn"
        class="rounded-lg border border-ink-600 px-3.5 py-2 text-xs font-semibold text-sand-300 transition-colors hover:border-mint-500/40 hover:text-sand-100"
      >
        ⤓ Download
      </button>
      <button
        type="button"
        id="copy-btn"
        class="rounded-lg bg-mint-500 px-4 py-2 text-xs font-bold text-ink-950 shadow-md shadow-mint-500/15 transition-colors hover:bg-mint-400"
      >
        Copy JSON-LD
      </button>
    </div>
  </div>
</div>
