---
import CodeOutput from './CodeOutput.astro';
import GeoChecklist from './GeoChecklist.astro';
---

<section id="builder" class="mx-auto max-w-7xl scroll-mt-20 px-4 py-16 sm:px-6 lg:px-8">
  <div class="mb-8">
    <p class="text-xs font-semibold uppercase tracking-widest text-mint-400">Schema builder</p>
    <div class="mt-2 flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">
        <span id="form-tool-name" class="text-sand-100">Article / Blog</span>
      </h2>
      <div class="flex items-center gap-2">
        <button type="button" id="load-example" class="rounded-lg border border-ink-600 px-3.5 py-2 text-xs font-semibold text-sand-300 transition-colors hover:border-mint-500/40 hover:text-sand-100">
          Load example
        </button>
        <button type="button" id="clear-form" class="rounded-lg border border-ink-600 px-3.5 py-2 text-xs font-semibold text-sand-300 transition-colors hover:border-red-400/50 hover:text-red-300">
          Clear
        </button>
      </div>
    </div>
    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-sand-500">
      Edit anything — the JSON-LD output and the GEO checklist update live. Everything runs in this tab; nothing is sent anywhere.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)]">
    <!-- form -->
    <form id="schema-form" class="min-w-0 space-y-7" novalidate></form>

    <!-- output + checklist -->
    <div class="min-w-0 lg:sticky lg:top-20 lg:self-start">
      <CodeOutput />
      <GeoChecklist />
    </div>
  </div>
</section>
