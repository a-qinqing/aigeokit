---
const chips = [
  { icon: '⚡', text: 'Zero backend — every tool runs in your browser' },
  { icon: '🛡️', text: 'No accounts, no data ever leaves your device' },
  { icon: '📋', text: 'Copy-paste JSON-LD & structured data in one click' },
  { icon: '🔎', text: 'Built for SearchGPT, Perplexity & AI Overviews' },
];
---

<section id="top" class="relative overflow-hidden">
  <!-- ambient glow -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute -top-32 left-1/2 h-[480px] w-[820px] -translate-x-1/2 rounded-full bg-mint-500/10 blur-[120px]"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 pb-20 pt-20 text-center sm:px-6 sm:pt-28 lg:px-8">
    <p class="mx-auto inline-flex items-center gap-2 rounded-full border border-ink-600 bg-ink-850 px-4 py-1.5 text-xs font-medium text-sand-400">
      <span class="text-mint-400">✦</span>
      AIGEOKit — free GEO toolkit for webmasters &amp; SEOs
    </p>

    <h1 class="mx-auto mt-7 max-w-4xl text-balance text-4xl font-extrabold leading-[1.08] tracking-tight sm:text-6xl">
      Get Cited by AI Search Engines —
      <span class="bg-gradient-to-r from-mint-400 to-cyan-400 bg-clip-text text-transparent">
        SearchGPT, Perplexity &amp; AI Overviews
      </span>
    </h1>

    <p class="mx-auto mt-6 max-w-2xl text-pretty text-base leading-relaxed text-sand-400 sm:text-lg">
      Free, privacy-first AI &amp; GEO tools for webmasters. Generate production-ready JSON-LD
      schema and pass the <strong class="text-sand-200">GEO Readiness Checklist</strong> in seconds.
    </p>

    <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href="/tools/" class="w-full rounded-xl bg-mint-500 px-7 py-3.5 text-sm font-bold text-ink-950 shadow-lg shadow-mint-500/20 transition-all hover:bg-mint-400 sm:w-auto">
        Explore Free Tools →
      </a>
      <a href="/#guide" class="w-full rounded-xl border border-ink-600 bg-ink-850 px-7 py-3.5 text-sm font-semibold text-sand-200 transition-colors hover:border-mint-500/40 hover:text-sand-100 sm:w-auto">
        View GEO Guide
      </a>
    </div>

    <ul class="mx-auto mt-14 grid max-w-3xl grid-cols-1 gap-3 sm:grid-cols-2">
      {chips.map((c) => (
        <li class="flex items-center justify-center gap-2 rounded-xl border border-ink-700/70 bg-ink-850/60 px-4 py-3 text-[13px] text-sand-300">
          <span aria-hidden="true">{c.icon}</span>{c.text}
        </li>
      ))}
    </ul>
  </div>
</section>
