---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const PAGE_URL = 'https://www.aigeokit.com/blog/';
const title = 'GEO & AI Search Guides | AIGEOKit';
const description =
  'Practical guides to llms.txt, AI crawler access and AI search visibility, written and tested by the person who builds the AIGEOKit tools.';

const CLUSTER_LABEL: Record<string, string> = {
  'llms-txt': 'llms.txt',
  'ai-crawlers': 'AI crawlers',
  'ai-visibility': 'AI visibility',
};

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
);

const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'AIGEOKit Guides',
  description,
  url: PAGE_URL,
  publisher: { '@id': 'https://www.aigeokit.com/#organization' },
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    url: `${PAGE_URL}${p.id}/`,
    datePublished: p.data.publishedDate.toISOString(),
    author: { '@type': 'Person', '@id': 'https://www.aigeokit.com/about/#founder', name: p.data.author },
  })),
};
---

<Layout title={title} description={description} canonical={PAGE_URL} jsonLd={jsonLd}>
  <Header />

  <main class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
    <nav aria-label="Breadcrumb" class="text-xs text-sand-500">
      <a href="/" class="transition-colors hover:text-mint-400">Home</a>
      <span class="px-2 text-ink-500">/</span>
      <span class="text-sand-300">Guides</span>
    </nav>

    <h1 class="mt-5 text-4xl font-extrabold leading-tight tracking-tight text-sand-100 sm:text-5xl">
      Guides to AI search
    </h1>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-sand-400">
      Everything here is written by the person who builds the tools — no guest posts, no AI-generated
      filler. Each guide explains one thing properly, then points at the free tool that does it.
    </p>

    <ul class="mt-12 space-y-4">
      {
        posts.map((post) => (
          <li>
            <a
              href={`/blog/${post.id}/`}
              class="group block rounded-2xl border border-ink-700 bg-ink-850 p-6 transition-colors hover:border-mint-500/40 sm:p-7"
            >
              <div class="flex flex-wrap items-center gap-3 text-[11px] uppercase tracking-widest text-sand-500">
                <span class="rounded-full border border-mint-500/30 bg-mint-500/10 px-2.5 py-1 font-bold text-mint-300">
                  {CLUSTER_LABEL[post.data.cluster] ?? post.data.cluster}
                </span>
                <time datetime={post.data.publishedDate.toISOString()}>{fmt.format(post.data.publishedDate)}</time>
                <span aria-hidden="true">·</span>
                <span>{post.data.author}</span>
              </div>
              <h2 class="mt-3 text-xl font-bold tracking-tight text-sand-100 group-hover:text-mint-200 sm:text-2xl">
                {post.data.title}
              </h2>
              <p class="mt-2 text-sm leading-relaxed text-sand-400">{post.data.description}</p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-mint-400">
                Read the guide <span aria-hidden="true">→</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>

  <Footer />
</Layout>
