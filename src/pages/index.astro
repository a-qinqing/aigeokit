---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SEOGuide from '../components/SEOGuide.astro';
import Footer from '../components/Footer.astro';

const SITE_URL = 'https://www.aigeokit.com/';
const title = 'Free AI & GEO Tools | Optimize Your Site for SearchGPT & Perplexity';
const description =
  '100% free AI & GEO toolkit for webmasters. Generate JSON-LD schema, boost citations, and get recommended by SearchGPT, Perplexity & AI Overviews.';

// Structured Data (JSON-LD for GEO/SEO)
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'AIGEOKit',
    url: SITE_URL,
    description,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'All',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    publisher: {
      '@type': 'Organization',
      name: 'AIGEOKit',
      url: SITE_URL,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'AIGEOKit',
    url: SITE_URL,
    logo: {
      '@type': 'ImageObject',
      url: 'https://www.aigeokit.com/og-image.png',
    },
    description,
  },
];
---

<Layout title={title} description={description} canonical={SITE_URL} jsonLd={jsonLd}>
  <Header />
  <Hero />

  <main>
    <!-- Featured tools — spacious stacked cards; everything else lives in /tools/ -->
    <section id="featured" class="relative mx-auto max-w-7xl scroll-mt-20 px-4 py-16 sm:px-6 lg:px-8">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0">
        <div class="absolute -top-24 right-0 h-[280px] w-[560px] rounded-full bg-mint-500/[0.07] blur-[100px]"></div>
      </div>

      <div class="space-y-6">
        <!-- Live: JSON-LD Schema Generator -->
        <div class="flex flex-col gap-8 overflow-hidden rounded-3xl border border-zinc-800/80 bg-ink-850 p-8 transition-colors hover:border-emerald-500/40 sm:p-10 lg:flex-row lg:items-center lg:justify-between">
          <div class="max-w-2xl">
            <p class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-mint-400">
              <span class="relative flex h-2 w-2">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-mint-400 opacity-60"></span>
                <span class="relative inline-flex h-2 w-2 rounded-full bg-mint-400"></span>
              </span>
              Featured tool · Live now
            </p>
            <h2 class="mt-3 text-2xl font-bold tracking-tight text-sand-100 sm:text-3xl">
              JSON-LD Schema Generator &amp; GEO Checklist
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-sand-400">
              Generate production-ready JSON-LD for Articles, FAQ, Products &amp; Organization with a
              live GEO Readiness score — free, 100% in your browser, no login required.
            </p>
            <ul class="mt-4 flex flex-wrap gap-2">
              <li class="rounded-full border border-ink-600 bg-ink-900 px-3 py-1 text-[11px] font-medium text-sand-300">Article / BlogPosting / NewsArticle</li>
              <li class="rounded-full border border-ink-600 bg-ink-900 px-3 py-1 text-[11px] font-medium text-sand-300">Raw JSON-LD · WordPress · Shopify</li>
              <li class="rounded-full border border-ink-600 bg-ink-900 px-3 py-1 text-[11px] font-medium text-sand-300">8 schema types</li>
            </ul>
          </div>
          <a
            href="/tools/schema-generator/"
            class="shrink-0 self-start rounded-xl bg-mint-500 px-7 py-3.5 text-center text-sm font-bold text-ink-950 shadow-lg shadow-mint-500/20 transition-all hover:bg-mint-400 sm:self-auto"
          >
            Open Tool →
          </a>
        </div>

        <!-- Live: AI Robots.txt Checker -->
        <div class="flex flex-col gap-8 overflow-hidden rounded-3xl border border-zinc-800/80 bg-ink-850 p-8 transition-colors hover:border-emerald-500/40 sm:p-10 lg:flex-row lg:items-center lg:justify-between">
          <div class="max-w-2xl">
            <p class="inline-flex items-center rounded-full border border-mint-500/30 bg-mint-500/15 px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest text-mint-300">
              New Tool • GEO Essential
            </p>
            <h2 class="mt-3 text-2xl font-bold tracking-tight text-sand-100 sm:text-3xl">
              AI Robots.txt Checker
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-sand-400">
              Test if GPTBot, OAI-SearchBot, PerplexityBot, and ClaudeBot can crawl your site.
              Get a 0-100 AI Crawlability Score with instant code fixes.
            </p>
            <ul class="mt-4 flex flex-wrap items-center gap-2">
              <li class="rounded-full border border-ink-600 bg-ink-900 px-3 py-1 text-[11px] font-medium text-sand-300">GPTBot &amp; PerplexityBot</li>
              <li aria-hidden="true" class="text-sand-600">·</li>
              <li class="rounded-full border border-ink-600 bg-ink-900 px-3 py-1 text-[11px] font-medium text-sand-300">RFC 9309 Rules</li>
              <li aria-hidden="true" class="text-sand-600">·</li>
              <li class="rounded-full border border-ink-600 bg-ink-900 px-3 py-1 text-[11px] font-medium text-sand-300">Privacy-First</li>
            </ul>
          </div>
          <a
            href="/tools/ai-robots-txt-checker/"
            class="shrink-0 self-start rounded-xl bg-mint-500 px-7 py-3.5 text-center text-sm font-bold text-ink-950 shadow-lg shadow-mint-500/20 transition-all hover:bg-mint-400 sm:self-auto"
          >
            Analyze Robots.txt →
          </a>
        </div>
      </div>

      <!-- Section-level link to the full suite -->
      <div class="mt-8 text-center">
        <a
          href="/tools/"
          class="inline-flex items-center gap-1.5 rounded-xl border border-ink-600 bg-ink-900 px-6 py-3 text-sm font-bold text-sand-100 transition-colors hover:border-mint-500/40 hover:text-mint-300"
        >
          View All Tools →
        </a>
      </div>
    </section>

    <SEOGuide />
  </main>

  <Footer />
</Layout>
