# Cloudflare Pages response headers (static hosting)
# Applied to every route of the geo-kit site.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# Astro emits content-hashed filenames — cache them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
